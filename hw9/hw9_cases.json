{
  "(a) Finite difference": [
    {
      "name": "Increasing position",
      "kind": "finite_difference",
      "args": [
        3,
        1,
        0.5
      ],
      "expected": [
        4.0
      ]
    },
    {
      "name": "Decreasing position",
      "kind": "finite_difference",
      "args": [
        -3,
        1,
        2
      ],
      "expected": [
        -2.0
      ]
    },
    {
      "name": "Constant position",
      "kind": "finite_difference",
      "args": [
        2,
        2,
        0.01
      ],
      "expected": [
        0.0
      ]
    },
    {
      "name": "Small change at 100 Hz",
      "kind": "finite_difference",
      "args": [
        0.002,
        0,
        0.01
      ],
      "expected": [
        0.2
      ]
    }
  ],
